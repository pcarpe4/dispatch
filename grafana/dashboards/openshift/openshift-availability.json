      "id": 9,
      "options": {
        "legend": {"calcs": ["mean", "min", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "count(min by (cluster) (cluster_operator_conditions{condition=\"Available\"}))",
          "legendFormat": "Total clusters reporting",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(clamp_max(min by (cluster) (cluster_operator_conditions{condition=\"Available\"}), 1))",
          "legendFormat": "Clusters fully available",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"}))",
          "legendFormat": "Clusters upgrading (planned)",
          "refId": "C"
        }
