{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus / Thanos datasource with multi-cluster OpenShift telemetry (metrics must carry a 'cluster' label; adjust label name if your estate uses a different one, e.g. '_id' for OCP telemetry)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "enable": true,
        "expr": "max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\",cluster=~\"$cluster\"}) == 1",
        "hide": false,
        "iconColor": "blue",
        "name": "Planned: cluster upgrade in progress",
        "step": "5m",
        "titleFormat": "Upgrade: {{cluster}}",
        "useValueForTime": false
      }
    ]
  },
  "description": "Historical availability across the OpenShift estate. Measures cluster and node availability, excludes planned maintenance (cluster upgrades, cordoned nodes) where possible, highlights clusters with the highest unplanned downtime, and supports drilldown from estate -> cluster -> node. Uptime percentages are computed over the dashboard time range (default 30 days).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Estate overview (uptime over selected time range)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Average cluster uptime across the estate over the selected time range, excluding planned maintenance windows (cluster upgrade in progress). A cluster counts as up when all ClusterOperators report Available=1.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 3,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.99},
              {"color": "green", "value": 0.995}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg(avg_over_time(((clamp_max((min by (cluster) (cluster_operator_conditions{condition=\"Available\"})) + on (cluster) (max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"})), 1)) or (min by (cluster) (cluster_operator_conditions{condition=\"Available\"})))[$__range:5m]))",
          "instant": true,
          "legendFormat": "Cluster uptime (excl. planned)",
          "refId": "A"
        }
      ],
      "title": "Estate cluster uptime (excl. planned maintenance)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Average cluster uptime across the estate over the selected time range with NO maintenance exclusion (raw availability).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 3,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.99},
              {"color": "green", "value": 0.995}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg(avg_over_time((min by (cluster) (cluster_operator_conditions{condition=\"Available\"}))[$__range:5m]))",
          "instant": true,
          "legendFormat": "Cluster uptime (raw)",
          "refId": "A"
        }
      ],
      "title": "Estate cluster uptime (raw, incl. maintenance)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Average node uptime across the estate over the selected time range, excluding planned maintenance (node cordoned / unschedulable, e.g. during drains and upgrades). A node counts as up when kube_node_status_condition{condition=\"Ready\"} is true.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 3,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.99},
              {"color": "green", "value": 0.995}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg(avg_over_time(((clamp_max(sum by (cluster, node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"}) + on (cluster, node) kube_node_spec_unschedulable, 1)) or (sum by (cluster, node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"})))[$__range:5m]))",
          "instant": true,
          "legendFormat": "Node uptime (excl. maintenance)",
          "refId": "A"
        }
      ],
      "title": "Estate node uptime (excl. planned maintenance)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Number of clusters whose uptime (excluding planned maintenance) over the selected time range is below the SLO threshold ($slo %).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "count((avg_over_time(((clamp_max((min by (cluster) (cluster_operator_conditions{condition=\"Available\"})) + on (cluster) (max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"})), 1)) or (min by (cluster) (cluster_operator_conditions{condition=\"Available\"})))[$__range:5m]) * 100) < $slo) or vector(0)",
          "instant": true,
          "legendFormat": "Clusters below SLO",
          "refId": "A"
        }
      ],
      "title": "Clusters below $slo% uptime SLO",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Nodes currently NotReady that are NOT cordoned, i.e. unplanned right now.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(((sum by (cluster, node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"})) == bool 0) * on (cluster, node) (1 - kube_node_spec_unschedulable)) or vector(0)",
          "instant": true,
          "legendFormat": "NotReady (unplanned)",
          "refId": "A"
        }
      ],
      "title": "Nodes NotReady now (unplanned)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Clusters currently in a planned maintenance window (cluster upgrade in progress).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "blue", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "count(max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"}) == 1) or vector(0)",
          "instant": true,
          "legendFormat": "Upgrading now",
          "refId": "A"
        }
      ],
      "title": "Clusters upgrading now (planned)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Clusters ranked by unplanned downtime percentage over the selected time range (planned maintenance windows excluded). Use this to target follow-up: click a cluster name, then set the $cluster variable to drill down.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 3,
          "mappings": [],
          "max": 0.05,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.005},
              {"color": "red", "value": 0.01}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 10, "x": 0, "y": 5},
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "topk(10, clamp_min(1 - avg_over_time(((clamp_max((min by (cluster) (cluster_operator_conditions{condition=\"Available\"})) + on (cluster) (max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"})), 1)) or (min by (cluster) (cluster_operator_conditions{condition=\"Available\"})))[$__range:5m]), 0))",
          "instant": true,
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 clusters by unplanned downtime",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Per-cluster availability over the selected time range: raw uptime, uptime excluding planned maintenance, time spent in planned maintenance, and unplanned downtime in minutes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto", "displayMode": "auto", "filterable": true, "inspect": false},
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Uptime raw %"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 99}, {"color": "green", "value": 99.5}]}},
              {"id": "custom.displayMode", "value": "color-text"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Uptime excl. planned %"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 99}, {"color": "green", "value": 99.5}]}},
              {"id": "custom.displayMode", "value": "color-text"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Planned maintenance %"},
            "properties": [{"id": "unit", "value": "percent"}]
          },
          {
            "matcher": {"id": "byName", "options": "Unplanned downtime (min)"},
            "properties": [
              {"id": "unit", "value": "m"},
              {"id": "decimals", "value": 1},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 30}]}},
              {"id": "custom.displayMode", "value": "color-text"}
            ]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 14, "x": 10, "y": 5},
      "id": 8,
      "options": {
        "footer": {"fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Unplanned downtime (min)"}]
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg_over_time((min by (cluster) (cluster_operator_conditions{condition=\"Available\"}))[$__range:5m]) * 100",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg_over_time(((clamp_max((min by (cluster) (cluster_operator_conditions{condition=\"Available\"})) + on (cluster) (max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"})), 1)) or (min by (cluster) (cluster_operator_conditions{condition=\"Available\"})))[$__range:5m]) * 100",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "(avg_over_time((max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"}))[$__range:5m]) * 100) or (min by (cluster) (cluster_operator_conditions{condition=\"Available\"}) * 0)",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "clamp_min(1 - avg_over_time(((clamp_max((min by (cluster) (cluster_operator_conditions{condition=\"Available\"})) + on (cluster) (max by (cluster) (cluster_operator_conditions{name=\"version\",condition=\"Progressing\"})), 1)) or (min by (cluster) (cluster_operator_conditions{condition=\"Available\"})))[$__range:5m]), 0) * $__range_s / 60",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "Cluster availability summary (selected range)",
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "indexByName": {},
            "renameByName": {
              "Value #A": "Uptime raw %",
              "Value #B": "Uptime excl. planned %",
              "Value #C": "Planned maintenance %",
              "Value #D": "Unplanned downtime (min)",
              "cluster": "Cluster"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Estate availability over time: total clusters reporting, clusters with all ClusterOperators available, and clusters in a planned upgrade window.",
      "fieldConfig": {
