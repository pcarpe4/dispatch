    {
      "id": 4,
      "type": "stat",
      "title": "OpenShift clusters reached",
      "description": "Distinct clusters among the OpenShift nodes in view. With a subnet or host as root this answers: how many clusters run on it?",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
