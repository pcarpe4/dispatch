// ---- NetObserv (flowlogs-pipeline) metrics ----
discovery.kubernetes "netobserv_flp" {
  role = "endpoints"
  namespaces {
    names = ["netobserv"]
  }
}

discovery.relabel "netobserv_flp" {
  targets = discovery.kubernetes.netobserv_flp.targets

  // Keep only the flowlogs-pipeline service
  rule {
    source_labels = ["__meta_kubernetes_service_label_app"]
    regex         = "flowlogs-pipeline"
    action        = "keep"
  }

  // Keep only the metrics endpoint (port named "prometheus")
  rule {
    source_labels = ["__meta_kubernetes_endpoint_port_name"]
    regex         = "prometheus"
    action        = "keep"
  }

  // Standard meta labels, matching your other jobs
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
    action        = "replace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
    action        = "replace"
  }
  rule {
    source_labels = ["__meta_kubernetes_service_name"]
    target_label  = "service"
    action        = "replace"
  }
}

prometheus.scrape "netobserv_flp" {
  job_name        = "integrations/netobserv/flowlogs-pipeline"
  targets         = discovery.relabel.netobserv_flp.output
  metrics_path    = "/metrics"
  scheme          = "http"          // FLP metrics endpoint is plain HTTP (per the ServiceMonitor)
  honor_labels    = true            // ServiceMonitor sets honorLabels: true
  scrape_interval = "15s"           // match the ServiceMonitor interval
  scrape_timeout  = "10s"
  clustering {
    enabled = true
  }
  forward_to = [prometheus.relabel.netobserv_flp.receiver]
}

prometheus.relabel "netobserv_flp" {
  // Replicate the ServiceMonitor's metricRelabelings: derive `namespace`
  // from Dst/Src K8S namespace on ingress/egress series.
  rule {
    source_labels = ["__name__", "DstK8S_Namespace"]
    separator     = "@"
    regex         = "netobserv_(workload|namespace)_ingress_.*@(.*)"
    target_label  = "namespace"
    replacement   = "${2}"
    action        = "replace"
  }
  rule {
    source_labels = ["__name__", "SrcK8S_Namespace"]
    separator     = "@"
    regex         = "netobserv_(workload|namespace)_(egress|flows|drop|rtt|dns)_.*@(.*)"
    target_label  = "namespace"
    replacement   = "${3}"
    action        = "replace"
  }

  forward_to = [prometheus.relabel.metrics_service.receiver]
}
