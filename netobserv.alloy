// ---- NetObserv (flowlogs-pipeline) metrics via PodMonitor CRDs ----
//
// NOTE / CAVEAT: Upstream NetObserv ships flowlogs-pipeline metrics through a
// *ServiceMonitor*, not a PodMonitor. `prometheus.operator.podmonitors` only
// discovers targets from PodMonitor CRDs, so this block will scrape nothing
// unless a PodMonitor resource exists in the `netobserv` namespace that selects
// the FLP pods (e.g. by `app=flowlogs-pipeline`) and exposes the "prometheus"
// metrics port. If you'd rather track the stock ServiceMonitor, swap this
// component for `prometheus.operator.servicemonitors` (same arguments).
prometheus.operator.podmonitors "netobserv_flp" {
  forward_to = [prometheus.relabel.netobserv_flp.receiver]
  clustering {
    enabled = true
  }
  namespaces = ["netobserv"]
}

prometheus.relabel "netobserv_flp" {
  forward_to = [prometheus.relabel.metrics_service.receiver]

  rule {
    action        = "replace"
    source_labels = ["__name__"]
    target_label  = "job"
    replacement   = "integrations/netobserv/flowlogs-pipeline"
  }

  // Replicate the ServiceMonitor's metricRelabelings: derive `namespace`
  // from Dst/Src K8S namespace on ingress/egress series.
  rule {
    source_labels = ["__name__", "DstK8S_Namespace"]
    separator     = "@"
    regex         = "netobserv_(workload|namespace)_ingress_.*@(.*)"
    target_label  = "namespace"
    replacement   = "${2}"
    action        = "replace"
  }
  rule {
    source_labels = ["__name__", "SrcK8S_Namespace"]
    separator     = "@"
    regex         = "netobserv_(workload|namespace)_(egress|flows|drop|rtt|dns)_.*@(.*)"
    target_label  = "namespace"
    replacement   = "${3}"
    action        = "replace"
  }
}
