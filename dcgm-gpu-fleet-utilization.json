{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus or Thanos datasource containing DCGM and kserve_vllm metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "bargauge", "name": "Bar gauge", "version": ""},
    {"type": "panel", "id": "table", "name": "Table", "version": ""}
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "GPU fleet utilization for the AI platform — designed for executive review of whether existing hardware warrants further investment. Covers compute utilization, memory capacity, AI-specific hardware efficiency, and the relationship between GPU saturation and AI workload demand.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total GPUs in Fleet",
      "description": "Total number of GPU devices across all selected clusters. Each device is counted independently regardless of size.",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "count(count by (UUID, cluster) (DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Fleet Avg Compute Utilization",
      "description": "Average GPU compute utilization across all GPUs and clusters. Green means significant capacity remains. Yellow signals the fleet is working hard. Red means the hardware is near its ceiling — the primary signal for a capacity expansion conversation.",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 65},
              {"color": "red", "value": 85}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Time Fleet Was Above 80% Utilized",
      "description": "Percentage of the selected time window in which the fleet-average compute utilization exceeded 80%. A value above 30-40% strongly supports a capacity expansion case — it means the hardware is routinely saturated during the period.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg_over_time((avg(DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) > bool 80)[$__range:5m]) * 100",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 20},
              {"color": "red", "value": 40}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Fleet Avg GPU Memory Utilization",
      "description": "Average fraction of GPU memory (VRAM) in use across all devices. For large AI models, memory fills before compute does — a high memory figure often represents the real capacity ceiling even when compute appears available.",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg(DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", modelName=~\"$gpu_model\"} / (DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", modelName=~\"$gpu_model\"} + DCGM_FI_DEV_FB_FREE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})) * 100",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 88}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "GPUs Currently Above 80% Load",
      "description": "Count of individual GPU devices currently running above 80% compute utilization. Even if the fleet average appears moderate, a large number of hot GPUs indicates some clusters or workloads are already at capacity.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "count(DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"} > 80) or vector(0)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 4}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Fleet Power Draw",
      "description": "Total power consumption across all GPU devices in kilowatts. Tracks operating cost and thermal load on datacenter infrastructure. Provides the cost baseline for a buy-vs-optimize analysis.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) / 1000",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {"mode": "fixed", "fixedColor": "purple"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      }
    },

    {
      "id": 7,
      "type": "row",
      "title": "GPU Compute Utilization",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "panels": []
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Average GPU Compute Utilization Over Time — by Cluster",
      "description": "Fleet-average GPU compute utilization per cluster over the selected window. The dashed reference line at 80% marks the threshold commonly used to justify capacity expansion. Sustained time above this line across multiple clusters is the clearest signal that more hardware is needed. A healthy target range for well-utilized infrastructure is 50–75%.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "vector(80)",
          "legendFormat": "80% — Expansion Threshold",
          "refId": "B",
          "hide": false
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "80% — Expansion Threshold"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 4]}},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      }
    },

    {
      "id": 9,
      "type": "bargauge",
      "title": "Current Avg Utilization by Cluster",
      "description": "Snapshot of each cluster's current average GPU compute utilization. A quick at-a-glance view of where each environment stands relative to the 80% expansion threshold.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})",
          "instant": true,
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 65},
              {"color": "red", "value": 85}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "GPU Memory Capacity",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "panels": []
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU Memory Used by Cluster (GiB)",
      "description": "Total GPU memory consumed across all devices in each cluster over time. The upper bound of each cluster's band represents its total installed GPU memory. When a cluster's usage approaches the top of its band, models cannot be scaled out further without adding hardware — even if compute utilization looks moderate.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (cluster) (DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) / 1024",
          "legendFormat": "Used — {{cluster}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (cluster) (DCGM_FI_DEV_FB_FREE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) / 1024",
          "legendFormat": "Free — {{cluster}}",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": false,
            "stacking": {"mode": "none"}
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "^Free.*"},
            "properties": [
              {"id": "custom.fillOpacity", "value": 5},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [4, 4]}},
              {"id": "custom.lineWidth", "value": 1}
            ]
          }
        ]
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU Memory Utilization % by Cluster",
      "description": "GPU memory utilization as a percentage of total installed capacity per cluster. For LLM workloads, memory saturation typically occurs before compute saturation — a cluster at 85%+ memory utilization has no room to load additional models or serve more concurrent sessions without adding GPUs.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", modelName=~\"$gpu_model\"} / (DCGM_FI_DEV_FB_USED{cluster=~\"$cluster\", modelName=~\"$gpu_model\"} + DCGM_FI_DEV_FB_FREE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})) * 100",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "vector(85)",
          "legendFormat": "85% — Memory Capacity Ceiling",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 88}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "85% — Memory Capacity Ceiling"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 4]}},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      }
    },

    {
      "id": 13,
      "type": "row",
      "title": "AI Hardware Efficiency",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "panels": []
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "Tensor Core Activity",
      "description": "Fraction of time the GPU's specialized AI processing units (Tensor Cores) are actively computing. Tensor Cores are purpose-built for AI matrix math and are the most valuable part of a modern data-center GPU. High values (50%+) mean the hardware investment is being put to its highest use. Low values may indicate that workloads are not structured to exploit the hardware's key capability.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) * 100",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      }
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Compute Engine Active",
      "description": "Fraction of time at least one compute warp was active on the GPU's streaming multiprocessors. This is the broadest measure of whether the GPU is doing any useful work. When Compute Engine Active is high but Tensor Core Activity is low, the GPU is busy but not on AI-specific workloads.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_PROF_GR_ENGINE_ACTIVE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) * 100",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      }
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "Memory Bus Activity",
      "description": "Fraction of time the GPU's high-bandwidth memory (HBM) interface is actively transferring data. LLM inference is often memory-bandwidth-bound — sustained high memory bus activity alongside moderate compute activity confirms the hardware is doing genuine AI work and is not idle between requests.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_PROF_DRAM_ACTIVE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) * 100",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      }
    },

    {
      "id": 17,
      "type": "row",
      "title": "The Case for More GPUs — Saturation vs. AI Demand",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "panels": []
    },

    {
      "id": 18,
      "type": "timeseries",
      "title": "GPU Compute Saturation Events (Peak Utilization per Cluster)",
      "description": "Maximum GPU utilization recorded across any single device in each cluster, sampled over time. Peaks represent moments when at least one GPU hit its ceiling. Frequent peaks at or near 100% confirm that hardware limits are being reached and that new requests arriving during these windows face delays or degraded performance.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "max by (cluster) (DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "vector(80)",
          "legendFormat": "80% Threshold",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "80% Threshold"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 4]}},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      }
    },

    {
      "id": 19,
      "type": "timeseries",
      "title": "AI Request Queue Depth (Requests Waiting for GPU)",
      "description": "Number of AI inference requests queued and waiting for a GPU at each point in time. Compare the timing of this chart directly with the saturation panel to the left — queue depth grows precisely when GPUs are fully occupied. This is the user-visible consequence of insufficient GPU capacity: requests wait instead of being served. A growing baseline queue (non-zero even off-peak) is a clear signal that the current hardware cannot absorb sustained demand.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (cluster) (kserve_vllm:num_requests_waiting{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Thermal & Power Health",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41},
      "panels": []
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Average GPU Temperature by Cluster",
      "description": "Average GPU core temperature across all devices per cluster. High sustained temperatures (above 80°C) reduce GPU lifespan and can trigger thermal throttling — which reduces performance even below the rated capacity. Persistent high temperatures under load are an infrastructure concern that accompanies heavy utilization.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg by (cluster) (DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\", modelName=~\"$gpu_model\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "red", "value": 85}
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "GPU Power Consumption by Cluster (kW)",
      "description": "Total GPU power draw in kilowatts per cluster over time. Power consumption scales with utilization — a cluster consistently near its TDP (Thermal Design Power) ceiling is also near its compute ceiling. This chart anchors the financial dimension of the capacity discussion: higher utilization means higher power costs, and understanding the current power envelope is necessary for datacenter capacity planning when adding more GPUs.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (cluster) (DCGM_FI_DEV_POWER_USAGE{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}) / 1000",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      }
    },

    {
