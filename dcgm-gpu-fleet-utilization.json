    {
      "id": 24,
      "type": "table",
      "title": "GPU Device Inventory — Current State",
      "description": "Per-device snapshot across the entire fleet. Each row is one physical GPU. Compute utilization, memory utilization, temperature, and power are shown at the current instant. Sort by Compute % or Memory % to identify the most constrained individual GPUs. A cluster where many rows show red values is a strong candidate for expansion.",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 51},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "DCGM_FI_DEV_GPU_UTIL{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}",
