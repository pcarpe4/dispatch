          "instant": true,
          "legendFormat": "__auto",
          "refId": "B",
          "format": "table"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\", modelName=~\"$gpu_model\"}",
