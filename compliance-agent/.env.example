# LLM (vLLM OpenAI-compatible)
LLM_BASE_URL=https://your-vllm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-oss-20b

# Embeddings (vLLM or any OpenAI-compatible endpoint). May equal LLM_*.
EMBED_BASE_URL=https://your-embed-host/v1
EMBED_API_KEY=replace-me
EMBED_MODEL=nomic-embed-text-v1.5

# Mongo
MONGO_URI=mongodb+srv://user:pass@cluster/db?retryWrites=true&w=majority
MONGO_DB=compliance

# Confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_TOKEN=replace-me
# Comma-separated space keys to index
CONFLUENCE_SPACES=COMP,POL

# Agent paths (defaults are fine for local dev)
INPUT_DIR=./data/raw
OUTPUT_DIR=./data/output
INSTRUCTIONS_PATH=./config/instructions.md
SETTINGS_PATH=./config/settings.yaml

# Chatbot
CHAT_HOST=0.0.0.0
CHAT_PORT=8080
